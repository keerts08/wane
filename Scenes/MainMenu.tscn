[sub_resource type="GDScript" id="GDScript_df05h"]
script/source = "extends Control

func _on_start_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Scenes/Level 1.tscn\")
	GlobalManager.player_health = 5
	GlobalManager.bullet_player_speed = 500
	GlobalManager.player_speed = 400
	GlobalManager.knowledge_sacrificed = false

func _on_story_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Scenes/Storyline.tscn\")
	
func _on_exit_pressed() -> void:
	get_tree().quit()
"

